<p>Olá <%= @resource.name %>,</p>

<% account_user = @resource&.account_users&.first %>
<% is_saml_account = account_user&.account&.saml_enabled? %>
<% brand_name = (global_config['BRAND_NAME'] || 'CRM3R') %>

<% if account_user&.inviter.present? && @resource.unconfirmed_email.blank? %>
  <% if is_saml_account %>
    <p><%= account_user.inviter.name %>, da <%= account_user.account.name %>, convidou você para acessar o <%= brand_name %> via Single Sign-On (SSO).</p>
    <p>Sua organização utiliza SSO para autenticação segura. Você não precisará de senha para acessar sua conta.</p>
  <% else %>
    <p><%= account_user.inviter.name %>, da <%= account_user.account.name %>, convidou você para usar o <%= brand_name %>.</p>
  <% end %>
<% end %>

<% if @resource.confirmed? %>
  <p>Você pode acessar sua conta do <%= brand_name %> usando o link abaixo:</p>
<% else %>
  <% if account_user&.inviter.blank? %>
  <p>
    Bem-vindo(a) ao <%= brand_name %>! Antes de começar, precisamos confirmar seu endereço de e-mail.
  </p>
  <% end %>
  <% unless is_saml_account %>
  <p>Por favor, clique no link abaixo para ativar sua conta.</p>
  <% end %>
<% end %>


<% if @resource.unconfirmed_email.present? %>
  <p><%= link_to 'Confirmar minha conta', frontend_url('auth/confirmation', confirmation_token: @token) %></p>
<% elsif @resource.confirmed? %>
  <% if is_saml_account %>
    <p>Você já pode acessar sua conta pelo portal SSO da sua organização.</p>
  <% else %>
    <p><%= link_to 'Acessar minha conta', frontend_url('auth/sign_in') %></p>
  <% end %>
<% elsif account_user&.inviter.present? %>
  <% if is_saml_account %>
    <p>Você pode acessar sua conta pelo portal SSO da sua organização.</p>
  <% else %>
    <p><%= link_to 'Definir minha senha e confirmar conta', frontend_url('auth/password/edit', reset_password_token: @resource.send(:set_reset_password_token)) %></p>
  <% end %>
<% else %>
  <p><%= link_to 'Confirmar minha conta', frontend_url('auth/confirmation', confirmation_token: @token) %></p>
<% end %>
